{
  "manifest_version": 3,
  "name": "Heracles Screen Capture Coach",
  "version": "0.1.0",
  "description": "Capture training screenshots, generate instructional markdown, and export both into a local folder.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Heracles Capture"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
